# ─────────────────────────────────────────────────────────────────────────────
# Open CDR Platform — environment (public / VPS deployment)
#
# .env.example's defaults are intentionally open for a local lab (no ingest
# key, no admin key, plain HTTP). This file is the same set of variables with
# the values a public deployment actually needs — copy it to .env and fill in
# the placeholders, don't reuse the ones shown here verbatim.
#
#   cp .env.production.example .env
#   openssl rand -hex 32       # generate each <...> key placeholder below
#   openssl rand -base64 24    # generate each <...> password placeholder below
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL — a real generated password, not the "change_me"/"callowl_pass" default
PGDATABASE=callowl
PGUSER=callowl
PGPASSWORD=<generate: openssl rand -base64 24>

# UI port on the host — whatever your reverse proxy forwards to
HTTP_PORT=8080

NODE_ENV=production

# Fine to leave on — these are the standard's own worked examples, not
# sensitive. Turn off once you don't want the 2024 sample data cluttering a
# "real" instance.
SEED_EXAMPLES=true

# Your real public origin, once you have one (single origin — see the note in
# .env.example). Defense in depth; session auth doesn't depend on this, since
# cookies aren't sent cross-origin regardless.
CORS_ORIGIN=https://your-domain.example

# REQUIRED before public exposure — without this, POST /calls/ingest accepts
# writes from anyone with no auth at all. Accepts a comma-separated list
# ("new,old") to rotate without a flag-day cutover — see SECRETS_ROTATION.md.
INGEST_API_KEY=<generate: openssl rand -hex 32>

BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# REQUIRED before public exposure — without this, trigger-backup,
# download-backup, and restore-from-upload (which replaces the whole database)
# are reachable by anyone, logged in or not. This is the single most important
# value in this file. Comma-separated list, same rotation support as
# INGEST_API_KEY.
ADMIN_API_KEY=<generate: openssl rand -hex 32>

# Change the username too if you don't want it guessable. Set a real password
# rather than leaving it blank — blank means one gets generated and printed to
# `podman logs callowl-backend` (or `docker compose logs backend`) on first
# boot instead, which works too, just make sure you actually capture it from
# there (it's not shown again).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=<generate: openssl rand -base64 18>

# REQUIRED once served over HTTPS, which it must be, publicly. Put a
# TLS-terminating reverse proxy in front of this stack first (Caddy is the
# easiest — auto-provisions Let's Encrypt certs; nginx+certbot or a Cloudflare
# Tunnel work too), *then* flip this to true. Flipping it before TLS exists
# means browsers silently refuse to send the session cookie and login breaks.
COOKIE_SECURE=true

# How long audit_log entries (who queried/ingested/administered what, and
# from where) are kept before being pruned. Runs once on boot, then daily.
AUDIT_LOG_RETENTION_DAYS=90

# Only required if you configure a remote source to pull CDRs from (⋯ menu →
# Remote sources) — encrypts that source's own credential at rest, since it
# has to be sent back out on every poll. 32 bytes, base64.
REMOTE_SOURCE_ENC_KEY=<generate: openssl rand -base64 32>

# Set only during a rotation window — see SECRETS_ROTATION.md. Leave blank otherwise.
REMOTE_SOURCE_ENC_KEY_PREVIOUS=

# Per-account login lockout, on top of the per-IP rate limit on
# POST /auth/login. Strongly recommended to leave at the default (or
# tighter) once reachable beyond a local lab.
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION_MINUTES=15

# Only required if you enable MFA (⋯ menu → Security) for at least one user —
# encrypts that user's TOTP secret at rest. Separate from
# REMOTE_SOURCE_ENC_KEY on purpose (see .env.example). 32 bytes, base64.
MFA_ENC_KEY=<generate: openssl rand -base64 32>

# Set only during a rotation window — see SECRETS_ROTATION.md. Leave blank otherwise.
MFA_ENC_KEY_PREVIOUS=

# How long remote_source_rejects entries (pulled records that failed
# validation) are kept before being pruned. Runs once on boot, then daily.
REMOTE_SOURCE_REJECTS_RETENTION_DAYS=90

# Self-hosted S3-compatible object storage (MinIO) — the pgBackRest
# WAL-archiving target for point-in-time recovery. Also doubles as the S3
# access key/secret pgBackRest uses. REQUIRED to change from any default —
# same posture as PGPASSWORD/ADMIN_API_KEY. See DISASTER_RECOVERY.md.
MINIO_ROOT_USER=<generate: openssl rand -hex 16>
MINIO_ROOT_PASSWORD=<generate: openssl rand -base64 24>
MINIO_BUCKET=callowl-pitr

# How often the db service's pgBackRest loop takes a new base backup.
# Separate from BACKUP_INTERVAL_HOURS (the existing pg_dump service) and
# from WAL archiving itself, which is continuous/automatic, not on this
# schedule.
PITR_BACKUP_INTERVAL_HOURS=24

# ─────────────────────────────────────────────────────────────────────────────
# CallOwl — environment
# Copy to .env and adjust before running:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (created on first run)
PGDATABASE=callowl
PGUSER=callowl
PGPASSWORD=change_me

# UI port on the host — plain HTTP, redirects straight to HTTPS below.
HTTP_PORT=8080

# UI over HTTPS — open https://localhost:${HTTPS_PORT}. Self-signed by
# default (frontend/docker-entrypoint.sh generates one on first boot into a
# persisted volume), so your browser will warn once until you trust it or
# mount a real cert/key over /etc/nginx/certs in the `frontend` container —
# see README's Deploying section.
HTTPS_PORT=8443

# Optional extra DNS name / IP the self-signed cert above should also cover
# (it always includes localhost/127.0.0.1) — set if you reach this host by
# a real hostname or LAN IP and don't want the browser warning to also
# complain about a name mismatch.
CALLOWL_HOST_NAME=
CALLOWL_HOST_IP=

# production | development
NODE_ENV=production

# Seed the five example scenarios from the Open CDR Standard on first boot
SEED_EXAMPLES=true

# Which origin(s) the API sends Access-Control-Allow-Origin for. "*" is fine
# for a local lab; set to your real origin once this is publicly reachable
# (a single origin — the underlying `cors` package option isn't wired up here
# to accept a comma-separated list).
CORS_ORIGIN=*

# Optional: require this key on POST /calls/ingest (X-API-Key header).
# Leave blank for open ingest (fine for a local lab). Accepts a comma-
# separated list ("new,old") to rotate without a flag-day cutover — see
# SECRETS_ROTATION.md.
INGEST_API_KEY=

# Scheduled pg_dump backups (see scripts/backup.sh, docker-compose's `backup`
# service). Dumps land in ./backups on the host.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Optional: an *additional* way (alongside a logged-in admin session, which
# always works and is never bypassed by leaving this blank) to authenticate
# triggering a backup on demand, downloading one, restoring from one, or
# replacing the TLS certificate. The read-only backup list does not need it.
# Leave blank for a local lab; set it once exposed beyond one, mainly for
# scripts/automation that can't hold a session cookie — restore replaces the
# database outright. Comma-separated list, same rotation support as
# INGEST_API_KEY.
ADMIN_API_KEY=

# Dashboard/API login is always required — there's no open mode. On first
# boot, if no users exist yet, one admin account is created automatically
# from these two values. Leave the password blank to have one generated and
# printed to the backend's startup logs instead (save it from there).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Session cookies are Secure by default since the frontend container
# terminates HTTPS by default (self-signed out of the box — see HTTPS_PORT
# above), and plain HTTP redirects to it rather than serving the app
# directly. Only set false if you're deliberately running this stack over
# plain HTTP with no TLS anywhere in front of it — otherwise browsers refuse
# to send the cookie over that, and login silently breaks.
COOKIE_SECURE=true

# How long audit_log entries (who queried/ingested/administered what) are
# kept before being pruned. Runs once on boot, then daily.
AUDIT_LOG_RETENTION_DAYS=90

# Optional: required only if you configure a remote source to pull CDRs from
# (⋯ menu → Remote sources) — encrypts that source's own credential (API key
# or OAuth2 client secret) at rest, since it has to be sent back out on every
# poll rather than just verified like this platform's own API keys. 32 bytes,
# base64: generate with `openssl rand -base64 32`. Leave blank until you
# actually add a remote source; creating one without this set returns a 501.
REMOTE_SOURCE_ENC_KEY=

# Set only during a rotation window (see SECRETS_ROTATION.md) — decrypt falls
# back to this key if REMOTE_SOURCE_ENC_KEY fails, so already-stored
# credentials keep working while you migrate. Unset once
# `npm run rotate-encryption-keys` has run successfully.
REMOTE_SOURCE_ENC_KEY_PREVIOUS=

# How long remote_source_rejects entries (pulled records that failed
# validation) are kept before being pruned. Runs once on boot, then daily.
REMOTE_SOURCE_REJECTS_RETENTION_DAYS=90

# Per-account login lockout, on top of the existing per-IP rate limit on
# POST /auth/login — closes the "slow, patient attempt spread across many
# source IPs" gap IP-based rate limiting alone can't. Locks after this many
# failed attempts against a given username (whether or not that username
# actually exists — see README), for this many minutes.
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION_MINUTES=15
# How long a lockout row lingers after its last attempt before being pruned
# (runs once on boot, then daily). Every username ever submitted gets a row
# here by design, so unlike the audit log this has no record-keeping value
# past the lockout window itself.
LOGIN_LOCKOUT_ROW_RETENTION_DAYS=7

# Required only if you enable MFA (⋯ menu → Security) for at least one user —
# encrypts that user's TOTP secret at rest, since it has to be read back to
# verify codes (unlike a password hash, which only ever needs comparing).
# Separate from REMOTE_SOURCE_ENC_KEY on purpose: a deployment that only
# wants MFA shouldn't need a key named for an unrelated feature, and
# rotating one shouldn't force everyone to re-enroll the other. 32 bytes,
# base64: generate with `openssl rand -base64 32`. Leave blank until someone
# actually enables MFA; enrolling without this set returns a 501.
MFA_ENC_KEY=

# Same rotation-window fallback as REMOTE_SOURCE_ENC_KEY_PREVIOUS, for MFA
# secrets — see SECRETS_ROTATION.md.
MFA_ENC_KEY_PREVIOUS=

# Self-hosted S3-compatible object storage (MinIO) — the pgBackRest
# WAL-archiving target for point-in-time recovery. Also doubles as the S3
# access key/secret pgBackRest uses. Change these from the defaults before
# this is reachable beyond your own machine — same posture as PGPASSWORD.
# See DISASTER_RECOVERY.md.
MINIO_ROOT_USER=opencdr-minio
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=callowl-pitr

# How often the db service's pgBackRest loop takes a new base backup.
# Separate from BACKUP_INTERVAL_HOURS (the existing pg_dump service) and
# from WAL archiving itself, which is continuous/automatic, not on this
# schedule.
PITR_BACKUP_INTERVAL_HOURS=24

# Off-host copy of both backup artifacts (pg_dump dumps + the PITR repo
# above) to a separate S3-compatible target you control — closes the "full
# host loss" gap noted in DISASTER_RECOVERY.md, since neither ./backups nor
# MinIO's own data volume otherwise leaves this host. Leave OFFSITE_S3_ENDPOINT
# blank to leave this off entirely (fine for a local lab); the `offsite-backup`
# compose service just idles until it's set. Works with AWS S3, Backblaze B2,
# another self-hosted MinIO elsewhere, or anything else speaking the S3 API.
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=
OFFSITE_S3_BUCKET=
# Set true only if OFFSITE_S3_ENDPOINT is itself self-signed (e.g. another
# MinIO you run) — leave false for AWS S3/B2/anything with a real cert.
OFFSITE_S3_INSECURE=false
OFFSITE_SYNC_INTERVAL_HOURS=24

# Outbound alerting on the health signals already computed above (pg_dump/
# PITR/off-host-sync staleness) plus remote-source poll failures — a
# scheduled backend job posts JSON to this URL on a healthy<->unhealthy
# transition, or every ALERT_COOLDOWN_HOURS if a condition stays unhealthy.
# The payload includes a `text` field, so a Slack/Discord incoming webhook
# URL works directly here too. Leave blank to leave alerting off entirely
# (fine for a local lab) — the scheduled check still runs but never posts.
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_HOURS=6
ALERT_CHECK_INTERVAL_MINUTES=5
